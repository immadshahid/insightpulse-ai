# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker-compose) ---
POSTGRES_USER=insightpulse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=insightpulse

# --- Backend ---
# Local (no Docker): postgresql+psycopg://insightpulse:change-me@localhost:5432/insightpulse
# Quick local dev without Postgres: sqlite:///./storage/dev.db
DATABASE_URL=postgresql+psycopg://insightpulse:change-me@localhost:5432/insightpulse
STORAGE_DIR=./storage
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_MINUTES=10080
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_MB=25

# --- AI (Phase 3) ---
# Leave the key empty to run without AI: insights, dashboards and ML still work, AI text
# falls back to templates, and Ask AI answers common questions with rules.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# LLM_ENABLED=true   # use another SDK credential source (ANTHROPIC_AUTH_TOKEN, ant profile)
